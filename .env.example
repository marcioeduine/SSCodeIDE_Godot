# Copy this file to `.env` in the project root and fill in your key.
# Never commit `.env` or the real API key.
#
# 1. Revoke any previously exposed NVIDIA NIM / DeepSeek key in the provider console.
# 2. Generate a new key.
# 3. Either export it in the shell:
#      export NVIDIA_NIM_API_KEY="your-new-key"
#    or set it below.

NVIDIA_NIM_API_KEY=
