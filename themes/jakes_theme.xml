<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jake's Theme — Adapted for SSCodeIDE
  Based on Jake's Theme for JetBrains IDEs
  Created by Ser Superior (SS)
-->

<theme name="jakes_theme" label="Jake's Theme">

  <!-- Backgrounds — true black chrome (JetBrains Jake's Theme is near-black) -->
  <colour key="bg_black"   value="#000000"/>
  <colour key="bg_darker"  value="#000000"/>
  <colour key="bg_surface" value="#000000"/>
  <colour key="bg_card"    value="#0a0a0a"/>
  <colour key="bg_lighter" value="#080808"/>

  <!-- Text -->
  <colour key="fg"         value="#e0e0e0"/>
  <colour key="fg_bright"  value="#ffffff"/>
  <colour key="muted"      value="#858585"/>

  <!-- Accent -->
  <colour key="blue"       value="#8be9fd"/>
  <colour key="green"      value="#57e389"/>
  <colour key="cyan"       value="#62a0ea"/>
  <colour key="red"        value="#ed333b"/>

  <!-- Syntax highlighting -->
  <colour key="hl_number"  value="#ffa348"/>
  <colour key="hl_symbol"  value="#9a9996"/>
  <colour key="hl_func"    value="#62a0ea"/>
  <colour key="hl_member"  value="#99c1f1"/>
  <colour key="hl_comment" value="#9a9996"/>
  <colour key="hl_string"  value="#57e389"/>

</theme>
